{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A histogram comparing arrivals into Australia in 2017 and 2021 using a population pyramid style with country labels.",
  "data": {
    "url": "https://raw.githubusercontent.com/saraalana/3179-A2/refs/heads/main/data/ArrivalsIntoAustralia2021.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "filter": " datum.Country == 'United States of America' || datum.Country == 'United Kingdom' || datum.Country == 'India' || datum.Country == 'China ' || datum.Country == 'New Zealand' || datum.Country == 'Japan'"
    },
    {
      "lookup": "Country",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/saraalana/3179-A2/refs/heads/main/data/ArrivalsIntoAustraliaIn2017.csv",
          "format": {"type": "csv"}
        },
        "key": "Country",
        "fields": ["Arrivals in 2017"]
      }
    },
    {
      "calculate": "'2021 Arrivals'", "as": "Year"
    },
    {
      "calculate": "-datum['Arrivals in 2017']", "as": "Signed_Arrivals_2017"
    },
    {
      "calculate": "datum['Arrivals in 2021']", "as": "Signed_Arrivals_2021"
    }
  ],
  "width": 400,
  "height": 300,
  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "Country",
          "sort": {"field": "Signed_Arrivals_2017", "order": "descending"},
          "axis": {"title": "Country"}
        },
        "x": {
          "field": "Signed_Arrivals_2017",
          "aggregate": "sum",
          "title": "Arrivals in 2017",
          "scale": {"domain": [-2000000, 2000000]},
          "axis": {"format": "s"}
        },
        "color": { "value": "#41ab5d" },
        "tooltip": [
          {"field": "Country", "type": "nominal", "title": "Country"},
          {"field": "Arrivals in 2017", "type": "quantitative", "title": "Arrivals in 2017"}
        ]
      }
    },
    {
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "Country",
          "sort": {"field": "Signed_Arrivals_2021", "order": "descending"},
          "axis": null
        },
        "x": {
          "field": "Signed_Arrivals_2021",
          "aggregate": "sum",
          "title": "Arrivals in 2021",
          "scale": {"domain": [-2900000, 2000000]},
          "axis": {"format": "s"}
        },
        "color": { "value": "#238b45" },
        "tooltip": [
          {"field": "Country", "type": "nominal", "title": "Country"},
          {"field": "Arrivals in 2021", "type": "quantitative", "title": "Arrivals in 2021"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": -5
      },
      "encoding": {
        "y": {
          "field": "Country",
          "sort": {"field": "Signed_Arrivals_2017", "order": "descending"},
          "axis": null
        },
        "text": {"field": "Country"},
        "x": {
          "value": 0
        },
        "color": {"value": "black"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {"grid": false}
  }
}
